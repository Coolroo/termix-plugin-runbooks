{
  "id": "runbooks",
  "name": "Runbooks",
  "version": "1.4.0",
  "description": "Runbooks an agent proposes and a person runs, one approved command at a time, with every output kept.",
  "author": {
    "name": "Coolroo"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Coolroo/termix-plugin-runbooks",
  "docs": "https://github.com/Coolroo/termix-plugin-runbooks/tree/main/docs",
  "category": "Productivity",
  "icon": "ListChecks",
  "features": [
    "Agents propose runbooks through a token API or MCP; they can never run anything",
    "Each agent token is limited to the hosts you choose for it",
    "A person runs each step after seeing the exact command and host",
    "Run over SSH or send the command to an open terminal and paste the output back",
    "Every run is kept, and a repeat of the same command asks first",
    "Values with {{name}} placeholders, filled by the author or captured from output",
    "Outputs can be hidden from agents step by step",
    "Standard input from an earlier step's output, a value or a secret",
    "Secrets captured from output and kept in OpenBao through the OpenBao Secrets plugin, never shown",
    "Agent steps: work the agent does itself between the person's steps, ended through the API",
    "Runbook events an agent can read or get as a signed webhook, off by default",
    "Send to agent on any step, with a short note",
    "Steps run outside Termix: the command with a Copy button, the pasted output checked",
    "Amendments: an agent fixes a step or adds one after it in place (3a), and later steps keep their numbers"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.0",
    "api": "^1.13"
  },
  "capabilities": [
    "db:own",
    "network:serve",
    "ui:surface",
    "hosts:read",
    "ssh:connect",
    "credentials:use",
    "network:outbound",
    "secrets:own"
  ],
  "requires": [
    {
      "service": "openbao-secrets.store",
      "versionRange": "^1.0.0",
      "optional": true
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "runbooks",
        "titleKey": "tab.title",
        "icon": "ListChecks",
        "openFrom": ["rail"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "manage-tokens",
        "titleKey": "permissions.manageTokens.title",
        "descriptionKey": "permissions.manageTokens.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "notifyEnabled",
          "type": "boolean",
          "labelKey": "settings.notifyEnabled.label",
          "descriptionKey": "settings.notifyEnabled.description",
          "default": false
        },
        {
          "key": "notifyUrl",
          "type": "string",
          "labelKey": "settings.notifyUrl.label",
          "descriptionKey": "settings.notifyUrl.description",
          "placeholderKey": "settings.notifyUrl.placeholder",
          "requires": "notifyEnabled"
        },
        {
          "key": "notifyCaPem",
          "type": "textarea",
          "labelKey": "settings.notifyCaPem.label",
          "descriptionKey": "settings.notifyCaPem.description",
          "requires": "notifyEnabled"
        },
        {
          "key": "notifySecret",
          "type": "custom",
          "component": "notify-secret",
          "requires": "notifyEnabled"
        },
        {
          "key": "stepColorsEditor",
          "type": "custom",
          "component": "step-colors"
        },
        {
          "key": "stepColors",
          "type": "json",
          "labelKey": "settings.stepColors.label",
          "hidden": true
        }
      ],
      "user": [
        {
          "key": "stepColorsEditor",
          "type": "custom",
          "component": "step-colors-user"
        },
        {
          "key": "stepColors",
          "type": "json",
          "labelKey": "settings.stepColors.label",
          "hidden": true
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "desktop": "server"
}
